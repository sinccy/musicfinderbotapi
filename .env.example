# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# OCR.space (free): https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
# auto | eng | rus
OCR_LANGUAGE=auto

# SerpAPI Google Lens (опционально, усиливает поиск по обложке)
# https://serpapi.com/ — free tier ~100 req/month
SERPAPI_API_KEY=

# Регион iTunes по умолчанию
DEFAULT_COUNTRY=ru

# Если api.telegram.org недоступен (РФ):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Spotify Web API — опционально (с 2026 нужен Premium у владельца приложения)
# Без ключей скачивание работает через Deezer + YouTube Music
# https://developer.spotify.com/dashboard → Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Яндекс.Музыка (опционально)
YANDEX_MUSIC_TOKEN=

# Genius API (опционально) — поиск по тексту / токен клиента
# https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# YouTube скачивание (если бот пишет «Sign in to confirm you’re not a bot»):
# Mac: YTDLP_COOKIES_FROM_BROWSER=chrome
# Сервер (Bothost): cookies.txt → YTDLP_COOKIES_FILE=/app/cookies.txt
# или YTDLP_COOKIES_B64=<base64 cookies.txt>
# YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_B64=
# YouTube Music: регион каталога (US/GB/DE). Один gl= часто мало —
# если альбомы всё равно не находятся, укажите прокси с IP нужной страны:
# YTMUSIC_PROXY=socks5://127.0.0.1:1080
YTMUSIC_LOCATION=US
YTMUSIC_LANGUAGE=en
YTMUSIC_PROXY=
